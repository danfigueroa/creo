HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parish_viva?sslmode=disable
# Pool pgx (opcionais; defaults: 8 / 0 / 30m / 5m)
DB_MAX_CONNS=8
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
JWT_ISSUER=https://example.supabase.co/auth/v1
JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
JWKS_CACHE_TTL=10m
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
PRAYED_WINDOW_HOURS=12
PRAYED_IP_BURST_PER_HOUR=200

# API pública de texto bíblico. O catálogo de referências vive no banco
# (bible_verses); só o texto vem daqui, e é persistido na primeira leitura.
BIBLE_API_BASE_URL=https://bible-api.com
BIBLE_TRANSLATION=almeida
BIBLE_API_TIMEOUT=3s
